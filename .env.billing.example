# Конфиг биллинг-бота провайдера (отдельный бот, свой токен).
# Положите как .env в папку, откуда запускаете billing_bot.py.

BILLING_BOT_TOKEN=              # токен биллинг-бота от @BotFather (отдельный бот!)
BILLING_ADMIN_IDS=             # твои Telegram ID через запятую (кто управляет подписками)
BILLING_DB_PATH=/opt/bots/billing.db   # та же общая БД, что у салонных ботов
TIMEZONE=Europe/Moscow
DEFAULT_TRIAL_DAYS=14          # на сколько дней регистрируется новый клиент по умолчанию
ANNUAL_PRICE=5000              # цена годовой подписки — подпись на кнопке «+1 год»
