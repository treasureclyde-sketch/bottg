# --- Обязательные ---
BOT_TOKEN=                       # токен от @BotFather
ADMIN_IDS=                       # Telegram ID админов через запятую, напр. 123456789,987654321

# --- Бизнес (подставляется в тексты) ---
BUSINESS_NAME=Барбершоп
BUSINESS_ADDRESS=
BUSINESS_PHONE=

# --- Время и слоты ---
TIMEZONE=Europe/Moscow
SLOT_STEP_MIN=30                 # шаг сетки слотов в минутах
BOOKING_HORIZON_DAYS=14          # на сколько дней вперёд можно записаться
BOOKING_BUFFER_MIN=30            # на сегодня не показывать слоты ближе, чем через N минут

# --- Напоминания ---
REMINDER_DAY_BEFORE_HOUR=20      # во сколько слать напоминание накануне (0-23)
REMINDER_2H_ENABLED=true         # включить напоминание за 2 часа
REMINDER_CHECK_INTERVAL_MIN=5    # как часто планировщик проверяет брони

# --- Хранилище ---
DB_PATH=bot.db

# --- Подписка (SaaS) ---
SUBSCRIPTION_UNTIL=              # дата 'ГГГГ-ММ-ДД', до которой оплачено. Пусто = бессрочно (fallback, если биллинг недоступен)
CLIENT_SLUG=                    # идентификатор этого салона в центральном биллинге (напр. borodach)
BILLING_DB_PATH=                # путь к общей billing.db. Пусто = биллинг выключен, берётся SUBSCRIPTION_UNTIL
PROVIDER_CONTACT=               # твой контакт (напр. @username) — показывается админу при неоплате

# --- Наши работы (портфолио) ---
WORKS_DIR=works                 # папка с фото примеров работ; нет папки/пусто = раздел скрыт
