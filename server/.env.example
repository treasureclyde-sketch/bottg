# Скопируй в .env и подставь свои значения:  cp .env.example .env

# Подключение к Postgres (поменяй ПАРОЛЬ на свой):
DATABASE_URL=postgresql://barber:ПОМЕНЯЙ_ПАРОЛЬ@localhost:5432/barbershop

# Секретный код доступа. Его же ты вводишь в приложении (вкладка «★ База»).
# Придумай длинный и случайный — это единственная защита твоих данных.
ACCESS_CODE=ПРИДУМАЙ_СЕКРЕТНЫЙ_КОД
