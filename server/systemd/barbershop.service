# systemd-юнит для автозапуска бэкенда.
# 1) Поменяй User и пути под свой сервер.
# 2) sudo cp barbershop.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now barbershop
# Логи:  journalctl -u barbershop -f

[Unit]
Description=Barbershop CRM (FastAPI)
After=network.target postgresql.service

[Service]
User=barber
WorkingDirectory=/opt/bottg/server
EnvironmentFile=/opt/bottg/server/.env
ExecStart=/opt/bottg/server/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
