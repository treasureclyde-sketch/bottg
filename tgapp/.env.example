# Скопируй в .env и заполни:  cp .env.example .env

# Домен мини-аппа (бесплатный поддомен DuckDNS). Покупать ничего не надо —
# зарегистрируй имя на https://www.duckdns.org и подставь сюда.
DOMAIN=твоё-имя.duckdns.org
WEBAPP_URL=https://твоё-имя.duckdns.org

# Токен DuckDNS (из личного кабинета). Нужен, чтобы скрипт сам привязал
# поддомен к IP сервера. Можно оставить пустым и привязать вручную на сайте.
DUCKDNS_TOKEN=

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ 2ГИС (бесплатный, https://dev.2gis.com — раздел Каталог/Places)
DGIS_KEY=
DGIS_CITY=Уфа
DGIS_QUERY=барбершоп

# Подключение к Postgres (пароль поменяет deploy.sh, если не задан)
DATABASE_URL=postgresql://barber:ПОМЕНЯЙ_ПАРОЛЬ@localhost:5432/barber
