# --- Telegram (обязательно) ---
# Создай бота у @BotFather → /newbot → скопируй токен.
# Чтобы бот отвечал в твоих чатах: у @BotFather включи Business Mode,
# затем подключи бота в Настройки → Telegram Business → Чат-боты (нужен Premium).
TELEGRAM_BOT_TOKEN=

# Твой личный telegram user id (бот слушается только тебя).
# Узнать: напиши боту @userinfobot.
OWNER_ID=

# --- OpenAI: мозг (GPT) + распознавание голоса (Whisper), один ключ ---
# https://platform.openai.com
OPENAI_API_KEY=

# --- 2ГИС: поиск мест (понадобится на шаге 2) ---
# https://dev.2gis.ru
DGIS_API_KEY=
